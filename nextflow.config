params {
    outdir = "results"
}

docker.enabled = true
// wave.enabled = true
// wave.strategy = ['conda']

process {
    errorStrategy = 'finish'
    publishDir = [ path: params.outdir, mode: 'copy', failOnError: true ]
    withName: 'CREATE_BWA_INDEX|EXTRACT_REGION_FROM_BAM' {
        publishDir = [enabled: false]
    }
}